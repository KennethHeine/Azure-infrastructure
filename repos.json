{
  "$schema": "./repos.schema.json",
  "gitHubOrg": "KennethHeine",
  "location": "swedencentral",
  "repos": [
    {
      "name": "kennethheine.com",
      "template": "static-web"
    },
    {
      "name": "kontoplan",
      "template": "container-app",
      "auth": true
    },
    {
      "name": "cvr-portal",
      "template": "container-app",
      "auth": true
    },
    "homelab",
    {
      "name": "agent",
      "template": "container-app",
      "auth": true,
      "preview": true,
      "sharedAcr": {
        "pullIdentities": [
          "id-agent",
          "id-agent-session",
          "id-agent-session-business",
          "id-agent-session-personal",
          "id-agent-session-sysadmin"
        ]
      }
    },
    {
      "name": "ks-integrations",
      "template": "none",
      "auth": false,
      "sharedAcr": {
        "pullIdentities": [
          "id-ks-integrations"
        ],
        "cloudBuild": false
      }
    }
  ]
}
